#!/usr/bin/expect -f
set timeout -1
spawn scp -o StrictHostKeyChecking=no deploy.sh root@129.121.125.62:/root/deploy.sh
expect "password:"
send "1Faisal@123\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no root@129.121.125.62 "chmod +x /root/deploy.sh && /root/deploy.sh"
expect "password:"
send "1Faisal@123\r"
expect eof
